# ---- Database ----
DATABASE_URL="postgresql://tubinator:tubinator@db:5432/tubinator?schema=public"
POSTGRES_USER=tubinator
POSTGRES_PASSWORD=tubinator
POSTGRES_DB=tubinator

# ---- NextAuth / Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- House API keys (fallback for casual users) ----
GROQ_API_KEY=""
YOUTUBE_API_KEY=""

# ---- BYOK encryption key (32 bytes) ----
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ---- House-key daily generation limit per user ----
HOUSE_DAILY_LIMIT="5"

# ---- Groq model ----
GROQ_MODEL="llama-3.3-70b-versatile"

# ---- Caddy domain (production TLS). Use localhost for local. ----
DOMAIN="localhost"
