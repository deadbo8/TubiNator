# ---- Database ----
DATABASE_URL="postgresql://tubinator:tubinator@db:5432/tubinator?schema=public"
POSTGRES_USER=tubinator
POSTGRES_PASSWORD=tubinator
POSTGRES_DB=tubinator

# ---- NextAuth / Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Must EXACTLY match the URL you access the app from.
# With DuckDNS behind your main Caddy:  https://tubinator.duckdns.org
# Local/IP only (self-signed):          https://YOUR_SERVER_IP:9443
NEXTAUTH_URL="https://tubinator.duckdns.org"

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- House API keys (fallback for casual users) ----
GROQ_API_KEY=""
YOUTUBE_API_KEY=""

# ---- BYOK encryption key (32 bytes) ----
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ---- House-key daily generation limit per user ----
HOUSE_DAILY_LIMIT="5"

# ---- Groq model ----
GROQ_MODEL="llama-3.3-70b-versatile"

# ---- Telegram bot ----
# Create a bot with @BotFather and paste its token here.
BOT_TOKEN=""
# Shared secret between the bot service and the /api/bot/* endpoints.
# Generate with: openssl rand -hex 24
BOT_API_SECRET=""

# ---- Domain ----
# Your DuckDNS hostname, e.g. tubinator.duckdns.org
# Only used by the OPTIONAL bundled caddy (profile: standalone-proxy).
# If you route through your existing main Caddy, set the domain there instead.
DOMAIN="tubinator.duckdns.org"

# ---- Email (SMTP) ----
# Used for email verification + passwordless OTP login.
# Works with any SMTP provider (Gmail, SendGrid, Brevo, Mailgun, etc.).
#
# Gmail (no domain required):
#   1. Enable 2-Step Verification on your Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-char App Password (NOT your normal password) below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
# The "from" address. For Gmail this should be the same as SMTP_USER.
EMAIL_FROM="Tubinator <your-gmail@gmail.com>"

# ---- Admin access ----
# Comma-separated list of emails that get admin dashboard access (web + Telegram).
ADMIN_EMAILS="clutter.ditch@gmail.com"
