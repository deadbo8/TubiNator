generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  telegramId      String?      @unique // set for users who joined via the Telegram bot
  emailVerified   DateTime?
  image           String?
  passwordHash    String?      // credentials login
  groqApiKey      String?      // encrypted, BYOK
  youtubeApiKey   String?      // encrypted, BYOK
  dailyGenCount   Int          @default(0)  // house-key rate limiting
  dailyGenResetAt DateTime?
  dailyGenLimit   Int?         // per-user override of the house daily limit (admin-set)
  banned          Boolean      @default(false)
  xp              Int          @default(0)  // gamification: total experience points
  streakCount     Int          @default(0)  // current consecutive-day streak
  longestStreak   Int          @default(0)
  lastActiveDate  DateTime?                  // UTC date of last learning activity (for streaks)
  accounts        Account[]
  courses         Course[]     // courses this user authored
  enrollments     Enrollment[]
  progress        Progress[]
  notes           Note[]
  reviews         Review[]
  createdAt       DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  topic       String
  level       String
  goal        String
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  isPublic    Boolean      @default(false) // listed in the public catalog
  slug        String?      @unique          // public, SEO-friendly URL slug
  publishedAt DateTime?
  createdAt   DateTime     @default(now())

  @@unique([topic, level, goal]) // dedupe / shared cache key
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Module {
  id       String   @id @default(cuid())
  title    String
  order    Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id           String     @id @default(cuid())
  title        String
  description  String     // AI summary / task
  youtubeQuery String
  order        Int
  videoId      String?
  video        Video?     @relation(fields: [videoId], references: [id])
  moduleId     String
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     Progress[]
  notes        Note[]
  reviews      Review[]
}

model Video {
  id          String   @id @default(cuid())
  youtubeId   String   @unique
  title       String
  channelName String
  duration    Int      // seconds
  viewCount   Int?
  likeCount   Int?
  cachedAt    DateTime @default(now())
  lessons     Lesson[]
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// Per-user notes attached to a lesson (a lesson maps to one video).
model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// Spaced-repetition review schedule (SM-2 lite). One row per user+lesson once
// the lesson is completed; dueAt advances as the user grades their recall.
model Review {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  intervalDays Int      @default(1)
  ease         Float    @default(2.5)
  reps         Int      @default(0)
  dueAt        DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, dueAt])
}

// Short-lived one-time codes for email verification and passwordless login.
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String   // "verify" | "login"
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}
